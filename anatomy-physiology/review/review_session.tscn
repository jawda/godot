[gd_scene format=3]

[ext_resource type="Script" path="res://review/review_session.gd" id="1_review"]
[ext_resource type="PackedScene" path="res://quiz/quiz_runner.tscn" id="2_quiz"]

[sub_resource type="InputEventKey" id="key_escape"]
keycode = 4194305

[sub_resource type="Shortcut" id="back_shortcut"]
events = [SubResource("key_escape")]

[node name="ReviewSession" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24
script = ExtResource("1_review")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Back" type="Button" parent="Layout/Header"]
layout_mode = 2
size_flags_vertical = 4
shortcut = SubResource("back_shortcut")
text = "← All modules"

[node name="Titles" type="VBoxContainer" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Kind" type="Label" parent="Layout/Header/Titles"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "REVIEW"

[node name="Title" type="Label" parent="Layout/Header/Titles"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "Mixed review"

[node name="Quiz" type="PanelContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="Runner" parent="Layout/Quiz" instance=ExtResource("2_quiz")]
layout_mode = 2
