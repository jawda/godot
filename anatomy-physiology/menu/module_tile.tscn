[gd_scene format=3]

[ext_resource type="Script" path="res://menu/module_tile.gd" id="1_tile"]

[node name="ModuleTile" type="Button"]
custom_minimum_size = Vector2(320, 228)
size_flags_horizontal = 3
focus_mode = 1
theme_type_variation = &"TileButton"
script = ExtResource("1_tile")

[node name="Content" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="Stack" type="VBoxContainer" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Number" type="Label" parent="Content/Stack"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "MODULE 1"

[node name="Title" type="Label" parent="Content/Stack"]
layout_mode = 2
theme_type_variation = &"TileTitle"
text = "Module title"
autowrap_mode = 3

[node name="Summary" type="Label" parent="Content/Stack"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"MutedLabel"
text = "Summary"
autowrap_mode = 3
text_overrun_behavior = 3
max_lines_visible = 2

[node name="Mastery" type="ProgressBar" parent="Content/Stack"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2
mouse_filter = 2
max_value = 1.0
show_percentage = false

[node name="MasteryCaption" type="Label" parent="Content/Stack"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Not started"
