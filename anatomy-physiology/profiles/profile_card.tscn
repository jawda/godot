[gd_scene format=3]

[ext_resource type="Script" path="res://profiles/profile_card.gd" id="1_card"]

[node name="ProfileCard" type="PanelContainer"]
size_flags_horizontal = 3
script = ExtResource("1_card")

[node name="Layout" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Details" type="VBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Name" type="Label" parent="Layout/Details"]
layout_mode = 2
theme_type_variation = &"TileTitle"
text = "Name"
text_overrun_behavior = 3

[node name="Summary" type="Label" parent="Layout/Details"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Last studied today"

[node name="Rename" type="Button" parent="Layout"]
layout_mode = 2
size_flags_vertical = 4
text = "Rename"

[node name="Export" type="Button" parent="Layout"]
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Save this profile's progress to a file you can import on another computer."
text = "Export"

[node name="Delete" type="Button" parent="Layout"]
layout_mode = 2
size_flags_vertical = 4
text = "Delete"

[node name="Open" type="Button" parent="Layout"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"AccentButton"
text = "Study"
