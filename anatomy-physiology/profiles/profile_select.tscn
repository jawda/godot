[gd_scene format=3]

[ext_resource type="Script" path="res://profiles/profile_select.gd" id="1_select"]

[node name="ProfileSelect" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 32
script = ExtResource("1_select")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Center" type="CenterContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Column" type="VBoxContainer" parent="Scroll/Center"]
custom_minimum_size = Vector2(760, 0)
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Scroll/Center/Column"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "Who's studying?"

[node name="Subtitle" type="Label" parent="Scroll/Center/Column"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Each profile keeps its own progress, and everything saves automatically as you go. Use Export and Import to carry a profile to another computer."
autowrap_mode = 3

[node name="Profiles" type="VBoxContainer" parent="Scroll/Center/Column"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="NoProfiles" type="Label" parent="Scroll/Center/Column"]
layout_mode = 2
text = "No profiles yet. Create one to get started."

[node name="NewProfile" type="HBoxContainer" parent="Scroll/Center/Column"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="NameInput" type="LineEdit" parent="Scroll/Center/Column/NewProfile"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Your name"
max_length = 40

[node name="Create" type="Button" parent="Scroll/Center/Column/NewProfile"]
layout_mode = 2
theme_type_variation = &"AccentButton"
text = "Create profile"

[node name="Import" type="Button" parent="Scroll/Center/Column/NewProfile"]
layout_mode = 2
tooltip_text = "Add a profile from a file exported on another computer."
text = "Import…"

[node name="Message" type="Label" parent="Scroll/Center/Column"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="ConfirmDelete" type="ConfirmationDialog" parent="."]
title = "Delete profile?"
size = Vector2i(460, 150)
ok_button_text = "Delete"
dialog_text = "This permanently deletes the profile and all of its progress."
dialog_autowrap = true

[node name="RenameDialog" type="ConfirmationDialog" parent="."]
title = "Rename profile"
size = Vector2i(420, 130)
ok_button_text = "Rename"

[node name="NewName" type="LineEdit" parent="RenameDialog"]
offset_left = 16.0
offset_top = 12.0
offset_right = 404.0
offset_bottom = 52.0
max_length = 40

[node name="ExportDialog" type="FileDialog" parent="."]
title = "Export profile"
size = Vector2i(760, 480)
access = 2
filters = PackedStringArray("*.json ; Study guide profile")
use_native_dialog = true

[node name="ImportDialog" type="FileDialog" parent="."]
title = "Import profile"
size = Vector2i(760, 480)
ok_button_text = "Open"
file_mode = 0
access = 2
filters = PackedStringArray("*.json ; Study guide profile")
use_native_dialog = true
