[gd_scene format=3]

[ext_resource type="Script" path="res://terminology/term_card.gd" id="1_card"]

[node name="TermCard" type="PanelContainer"]
size_flags_horizontal = 3
script = ExtResource("1_card")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Kind" type="Label" parent="Layout"]
layout_mode = 2
theme_type_variation = &"CalloutTipLabel"
text = "ROOT"

[node name="Term" type="Label" parent="Layout"]
layout_mode = 2
theme_type_variation = &"SectionHeading"
text = "oste/o"
autowrap_mode = 3

[node name="Meaning" type="Label" parent="Layout"]
layout_mode = 2
theme_type_variation = &"TileTitle"
text = "bone"
autowrap_mode = 3

[node name="Details" type="RichTextLabel" parent="Layout"]
layout_mode = 2
focus_mode = 0
bbcode_enabled = true
fit_content = true
scroll_active = false
