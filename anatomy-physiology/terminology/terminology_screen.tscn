[gd_scene format=3]

[ext_resource type="Script" path="res://terminology/terminology_screen.gd" id="1_screen"]
[ext_resource type="PackedScene" path="res://terminology/term_reference.tscn" id="2_reference"]
[ext_resource type="PackedScene" path="res://flashcards/flashcard_deck.tscn" id="3_deck"]
[ext_resource type="PackedScene" path="res://quiz/quiz_runner.tscn" id="4_quiz"]

[sub_resource type="InputEventKey" id="key_escape"]
keycode = 4194305

[sub_resource type="Shortcut" id="back_shortcut"]
events = [SubResource("key_escape")]

[node name="TerminologyScreen" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24
script = ExtResource("1_screen")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Back" type="Button" parent="Layout/Header"]
layout_mode = 2
size_flags_vertical = 4
shortcut = SubResource("back_shortcut")
text = "← All modules"

[node name="Titles" type="VBoxContainer" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Kind" type="Label" parent="Layout/Header/Titles"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "QUICK REFERENCE"

[node name="Title" type="Label" parent="Layout/Header/Titles"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "Medical terms"

[node name="Practice" type="HBoxContainer" parent="Layout/Header"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 10

[node name="Caption" type="Label" parent="Layout/Header/Practice"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Practice"

[node name="PracticeSet" type="OptionButton" parent="Layout/Header/Practice"]
layout_mode = 2
focus_mode = 0
tooltip_text = "Which terms the flashcards and quiz use"
selected = 0
item_count = 8
popup/item_0/text = "Word parts (prefixes, roots, suffixes)"
popup/item_0/id = 0
popup/item_1/text = "Prefixes"
popup/item_1/id = 1
popup/item_2/text = "Roots"
popup/item_2/id = 2
popup/item_3/text = "Suffixes"
popup/item_3/id = 3
popup/item_4/text = "Words from the lessons"
popup/item_4/id = 4
popup/item_5/text = "Body terms"
popup/item_5/id = 5
popup/item_6/text = "Abbreviations"
popup/item_6/id = 6
popup/item_7/text = "Everything"
popup/item_7/id = 7

[node name="Sections" type="TabContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
current_tab = 0

[node name="Reference" parent="Layout/Sections" instance=ExtResource("2_reference")]
layout_mode = 2
metadata/_tab_index = 0

[node name="Flashcards" parent="Layout/Sections" instance=ExtResource("3_deck")]
visible = false
layout_mode = 2
metadata/_tab_index = 1

[node name="Quiz" parent="Layout/Sections" instance=ExtResource("4_quiz")]
visible = false
layout_mode = 2
metadata/_tab_index = 2
